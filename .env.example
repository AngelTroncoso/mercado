# ========================================================
# CONFIGURACIÓN DE LLM (GEMINI U OPENAI)
# ========================================================
# Proveedor principal: "gemini" o "openai"
LLM_PROVIDER=gemini

# Google Gemini (Recomendado - Obtén tu clave en https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Opcional - https://platform.openai.com/)
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o

# ========================================================
# CONFIGURACIÓN DE BÚSQUEDA WEB
# ========================================================
# Proveedor de búsqueda: "tavily" (con fallback automático a duckduckgo)
TAVILY_API_KEY=tu_tavily_api_key_aqui
SEARCH_PROVIDER=tavily

# Nivel de detalle de búsqueda Tavily: "basic" o "advanced"
TAVILY_SEARCH_DEPTH=advanced
